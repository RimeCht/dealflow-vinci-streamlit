AZURE_OPENAI_ENDPOINT=https://votre-ressource.openai.azure.com/
AZURE_OPENAI_API_KEY=REMPLACER_PAR_LA_CLE_SERVEUR
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-2
AZURE_OPENAI_API_VERSION=2024-12-01-preview
DEALFLOW_PROFILE=EUROPE

ALGO1_LIMIT_ROWS=0
ALGO2_LIMIT_ROWS=0
ALGO3_LIMIT_ROWS=0

ALGO1_MAX_WORKERS=1
ALGO2_MAX_WORKERS=1
ALGO3_MAX_WORKERS=1

PIPELINE_SAVE_EVERY=5
PIPELINE_RESUME_FROM_TEMP=1
PIPELINE_GENERATE_DASHBOARD=1
PIPELINE_ALGO1_PASS_DECISIONS=A_GARDER
PIPELINE_ALGO2_PASS_DECISIONS=PREQUALIFIEE

ALGO2_ELIGIBLE_DECISIONS=A_GARDER
ALGO3_ELIGIBLE_DECISIONS=PREQUALIFIEE

ALGO2_TARGETED_RESEARCH=1
ALGO2_RESEARCH_MAX_PAGES=5
ALGO2_RESEARCH_MAX_LINKS_TO_TRY=15
ALGO2_RESEARCH_TIMEOUT_SECONDS=6
ALGO2_RESEARCH_MAX_TEXT_CHARS=5000
ALGO2_RESEARCH_TEXT_PER_PAGE_CHARS=1400

ALGO3_TARGETED_MATURITY_RESEARCH=1
ALGO3_RESEARCH_MAX_PAGES=5
ALGO3_RESEARCH_MAX_LINKS_TO_TRY=15
ALGO3_RESEARCH_TIMEOUT_SECONDS=6
ALGO3_RESEARCH_MAX_TEXT_CHARS=5000
ALGO3_RESEARCH_TEXT_PER_PAGE_CHARS=1400

ALGO3_ENABLE_RECHERCHE_ENTREPRISES_API=1
ALGO3_ENABLE_SOCIETE_SEARCH=1
ALGO3_SOCIETE_NAME_SEARCH=0
ALGO3_ENABLE_LINKEDIN_EMPLOYEE_SEARCH=1

LOCAL_SEMANTIC_PREFILTER=1
LOCAL_SEMANTIC_USE_TRANSFORMER=0
LEARNING_ENABLED=1
LEARNING_MEMORY_PATH=learning_memory.json
